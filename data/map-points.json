{
  "version": 1,
  "id": "journey-point-types",
  "integration": {
    "status": "integrated",
    "runtimeEnabled": true,
    "clients": [
      "mobile"
    ],
    "adapter": "mobile/game/campaign.gd",
    "rules": "data/story-gameplay.json",
    "note": "Godot использует весь каталог."
  },
  "artDirection": "docs/ART_DIRECTION.md",
  "presentation": {
    "shape": "circle",
    "frame": "/map-points/frame.png",
    "rim": "/map-points/rim.png",
    "background": "/map-points/background.png",
    "symbolBox": {
      "x": 0.19,
      "y": 0.19,
      "width": 0.62,
      "height": 0.62
    },
    "exportSize": 512,
    "displaySizes": [
      48,
      64,
      96
    ],
    "minimumDisplaySize": 48,
    "shadow": "0 2px 3px #000b",
    "labelPolicy": "tooltipAndAccessibleNameRequired; selectedPointDetails",
    "statePolicy": "completedGrayscaleWithRoundCheck; skippedGrayscale; futureEmptyFrame; currentHeroPortrait; selectedGoldShadow",
    "unknownPolicy": "doNotShowHiddenCharacterIdentityOrContentsOfCargo",
    "backing": {
      "color": "#111513",
      "inset": 0.08
    }
  },
  "points": [
    {
      "id": "combat",
      "name": "Бой",
      "category": "combat",
      "description": "Столкновение с обычным противником. Причину боя, собеседника и вид врага задаёт сцена.",
      "symbolDescription": "Скрещённые клинки — условный знак боя, а не назначенная врагу экипировка.",
      "storyLabels": [],
      "actionLabel": "Начать бой",
      "icon": {
        "src": "/map-points/combat.png",
        "symbol": "/map-points/symbols/combat.png",
        "alt": "Бой"
      },
      "engineBinding": {
        "status": "existingMechanic",
        "route": "fight",
        "effectBinding": "existingCombat",
        "isBoss": false
      },
      "availability": "whenRouteExists"
    },
    {
      "id": "boss",
      "name": "Босс",
      "category": "combat",
      "description": "Заключительный бой карты. После победы выполняются события главы; в финале кампании открывается выбор судьбы аттрактора.",
      "symbolDescription": "Череп с короной обозначает опасность этапа, а не вид противника.",
      "storyLabels": [],
      "actionLabel": "Сразиться с боссом",
      "icon": {
        "src": "/map-points/boss.png",
        "symbol": "/map-points/symbols/boss.png",
        "alt": "Босс"
      },
      "engineBinding": {
        "status": "existingMechanic",
        "route": "fight",
        "effectBinding": "existingBossCombat",
        "isBoss": true
      },
      "availability": "whenRouteExists"
    },
    {
      "id": "campfire",
      "name": "Костёр",
      "category": "rest",
      "description": "Отдых и подготовка к следующему бою. Место может быть костром под навесом, в караулке или у подворья.",
      "symbolDescription": "Пламя над двумя поленьями.",
      "storyLabels": [
        "Костёр"
      ],
      "actionLabel": "Отдохнуть",
      "icon": {
        "src": "/map-points/campfire.png",
        "symbol": "/map-points/symbols/campfire.png",
        "alt": "Костёр"
      },
      "engineBinding": {
        "status": "existingMechanic",
        "route": "camp",
        "effectBinding": "existingCampfire",
        "isBoss": null
      },
      "availability": "whenRouteExists"
    },
    {
      "id": "forge",
      "name": "Кузница",
      "category": "service",
      "description": "Работа со снаряжением по действующим правилам кузницы. В глуши это мастерская или переносная наковальня, а не обязательно отдельное здание.",
      "symbolDescription": "Наковальня с молотом.",
      "storyLabels": [
        "Кузница"
      ],
      "actionLabel": "Открыть кузницу",
      "icon": {
        "src": "/map-points/forge.png",
