        "effectBinding": "existingForge",
        "isBoss": null
      },
      "availability": "whenRouteExists"
    },
    {
      "id": "healer",
      "name": "Лечебница",
      "category": "service",
      "description": "Помощь больным и разговор со служителями приёмного дома или приюта хранителей. Численная польза услуги ещё не назначена.",
      "symbolDescription": "Ступка, пестик и листья лечебных трав.",
      "storyLabels": [
