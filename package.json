  "scripts": {
    "check": "npm run check:story && npm run check:map-points && npm run check:story-runtime",
    "check:story": "node tools/validate-story.mjs",
    "test:story": "node --test tools/validate-story.test.mjs",
    "check:map-points": "node tools/validate-map-points.mjs",
    "preview:map-points": "node tools/preview-map-points.mjs",
