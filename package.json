{
  "name": "duelyant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "balance": "tsx scripts/balance.ts",
    "storybook:catalog": "tsx scripts/storybook-catalog.ts",
    "storybook": "npm run storybook:catalog && storybook dev -p 6006 --host 127.0.0.1 --no-open --disable-telemetry",
    "build-storybook": "npm run storybook:catalog && storybook build --disable-telemetry",
    "test:storybook": "npm run storybook:catalog && tsx scripts/check-storybook.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "3.9.9",
    "storybook": "10.6.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^6.0.7"
  }
}
